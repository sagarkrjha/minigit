# ==============================================================================
# Dockerfile for MiniGit SDK consumer demo
# ==============================================================================
FROM ubuntu:24.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    ninja-build \
    libssl-dev \
    zlib1g-dev \
    libcurl4-openssl-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
COPY . .

RUN cmake -B build -S . -G Ninja -DCMAKE_BUILD_TYPE=Release
RUN cmake --build build --parallel

# Compile demo against SDK headers and static archive
RUN g++ -std=c++20 \
    -Isrc \
    -Isrc/sdk \
    examples/sdk_demo.cpp \
    -Wl,--start-group \
    build/src/sdk/libminigit_sdk.a \
    build/src/core/libminigit_core.a \
    build/src/repository/libminigit_repository.a \
    build/src/storage/libminigit_storage.a \
    build/src/staging/libminigit_staging.a \
    build/src/history/libminigit_history.a \
    build/src/branching/libminigit_branching.a \
    -Wl,--end-group \
    -lssl -lcrypto -lz -lcurl \
    -o /workspace/sdk_demo

FROM ubuntu:24.04 AS runtime

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    libssl3 \
    zlib1g \
    libcurl4 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /workspace/sdk_demo /usr/local/bin/sdk_demo

WORKDIR /data
VOLUME ["/data"]

ENTRYPOINT ["/usr/local/bin/sdk_demo"]
